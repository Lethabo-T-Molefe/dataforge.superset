# Copy to .env. Every setting also reads from the environment.

# Superset's own database (users, dashboards, charts). Keep it apart from DataForge's data: its own database,
# never the schema a public data API can read.
SUPERSET_METADATA_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/superset
# On Supabase: use the session pooler (the direct db.<project>.supabase.co host is IPv6-only), a database named
# superset created with `CREATE DATABASE superset` (not postgres, whose public schema the data API serves), and
# TLS. Percent-encode special characters in the password (@ is %40).
# SUPERSET_METADATA_URL=postgresql+psycopg2://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/superset?sslmode=require
SUPERSET_SECRET_KEY=replace-with-a-long-random-value
SUPERSET_GUEST_TOKEN_SECRET=replace-with-a-long-random-value

# The service account the DataForge API uses for Superset's REST API.
# Must match SUPERSET_ADMIN_USER and SUPERSET_ADMIN_PASSWORD in the API's settings.
SUPERSET_ADMIN_USER=dataforge-service
SUPERSET_ADMIN_PASSWORD=replace-with-a-long-random-value

# Single sign-on from DataForge. Must match SSO_SHARED_SECRET and JWT_ISSUER in the API's settings.
SSO_SHARED_SECRET=replace-with-the-api-sso-secret
DATAFORGE_JWT_ISSUER=dataforge

# Origins allowed to embed Superset (the DataForge web app), comma-separated.
DATAFORGE_FRONTEND_ORIGINS=http://localhost:8080,http://localhost:5173

# Local development server (run.py). In the container, PORT and GUNICORN_WORKERS are used instead.
SUPERSET_PORT=8088

# Set to true when served over HTTPS behind a proxy: secure cookies, HSTS, and trust in the proxy's headers.
SUPERSET_FORCE_HTTPS=false

# Optional: shared rate limits across instances.
# REDIS_URL=redis://localhost:6379/0
